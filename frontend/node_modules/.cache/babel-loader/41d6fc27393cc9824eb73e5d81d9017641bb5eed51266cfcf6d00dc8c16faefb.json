{"ast":null,"code":"export default {\n  name: 'HUD',\n  data() {\n    return {\n      speed: 0,\n      position: 'X:0.0 Y:0.0 Z:0.0',\n      health: 100,\n      threat: '없음',\n      isConnected: true,\n      signalStrength: 4,\n      gear: 2\n    };\n  },\n  computed: {\n    threatClass() {\n      if (this.threat === '없음') return 'threat-none';\n      if (this.threat.includes('높음')) return 'threat-level-3';\n      if (this.threat.includes('중간')) return 'threat-level-2';\n      return 'threat-level-1';\n    },\n    commClass() {\n      if (!this.isConnected) return 'status-danger';\n      if (this.signalStrength <= 1) return 'status-weak';\n      return 'status-normal';\n    }\n  },\n  mounted() {\n    this.updateStatus();\n    setInterval(this.updateStatus, 1000);\n  },\n  methods: {\n    async updateStatus() {\n      try {\n        const res = await fetch(`${process.env.VUE_APP_API_URL}/get_status`);\n        const data = await res.json();\n        this.speed = data.player_speed;\n        this.health = data.player_health;\n        this.gear = data.gear || 2;\n        this.position = `X:${data.player_pos.x.toFixed(1)} Y:${data.player_pos.y.toFixed(1)} Z:${data.player_pos.z.toFixed(1)}`;\n        this.threat = data.threat || '없음';\n        this.isConnected = data.is_info_received;\n        this.signalStrength = this.isConnected ? 4 : 0;\n      } catch (e) {\n        console.error('get_status API 오류:', e);\n        this.isConnected = false;\n        this.signalStrength = 0;\n      }\n    },\n    getSignalClass(index) {\n      if (!this.isConnected) return 'disconnected';\n      if (index <= this.signalStrength) return 'active';\n      return 'inactive';\n    }\n  }\n};","map":{"version":3,"names":["name","data","speed","position","health","threat","isConnected","signalStrength","gear","computed","threatClass","includes","commClass","mounted","updateStatus","setInterval","methods","res","fetch","process","env","VUE_APP_API_URL","json","player_speed","player_health","player_pos","x","toFixed","y","z","is_info_received","e","console","error","getSignalClass","index"],"sources":["C:\\pycode\\Battlefield-object-recognition-learning-model\\frontend\\src\\components\\HUD.vue"],"sourcesContent":["<template>\r\n  <div class=\"hud\">\r\n    <div class=\"hud-item\" id=\"speed\">속도: {{ speed }} km/h</div>\r\n    <div class=\"hud-item\" id=\"position\">좌표: {{ position }}</div>\r\n    <div class=\"hud-item\" id=\"health\">\r\n      <div>전차 체력</div>\r\n      <div class=\"health-bar\">\r\n        <div :style=\"{ width: health + '%' }\" class=\"health-fill\"></div>\r\n      </div>\r\n      <div id=\"health-text\">{{ health }}%</div>\r\n    </div>\r\n    <div class=\"hud-item\" :class=\"threatClass\" id=\"threat\">\r\n      🚨 위협 감지: {{ threat }}\r\n    </div>\r\n    <div class=\"hud-item\" :class=\"commClass\" id=\"comm\">\r\n      <div>📡 통신 신호</div>\r\n      <div class=\"signal-bar\">\r\n        <div v-for=\"i in 4\" :key=\"i\" \r\n             :class=\"['bar', getSignalClass(i)]\"></div>\r\n        <div v-if=\"!isConnected\" id=\"signal-error-icon\">✖</div>\r\n      </div>\r\n    </div>\r\n    <div class=\"hud-item\" id=\"gear\">\r\n      🔧 기어: <span id=\"gear-level\">{{ gear }}</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'HUD',\r\n  data() {\r\n    return {\r\n      speed: 0,\r\n      position: 'X:0.0 Y:0.0 Z:0.0',\r\n      health: 100,\r\n      threat: '없음',\r\n      isConnected: true,\r\n      signalStrength: 4,\r\n      gear: 2\r\n    }\r\n  },\r\n  computed: {\r\n    threatClass() {\r\n      if (this.threat === '없음') return 'threat-none'\r\n      if (this.threat.includes('높음')) return 'threat-level-3'\r\n      if (this.threat.includes('중간')) return 'threat-level-2'\r\n      return 'threat-level-1'\r\n    },\r\n    commClass() {\r\n      if (!this.isConnected) return 'status-danger'\r\n      if (this.signalStrength <= 1) return 'status-weak'\r\n      return 'status-normal'\r\n    }\r\n  },\r\n  mounted() {\r\n    this.updateStatus()\r\n    setInterval(this.updateStatus, 1000)\r\n  },\r\n  methods: {\r\n    async updateStatus() {\r\n      try {\r\n        const res = await fetch(`${process.env.VUE_APP_API_URL}/get_status`)\r\n        const data = await res.json()\r\n\r\n        this.speed = data.player_speed\r\n        this.health = data.player_health\r\n        this.gear = data.gear || 2\r\n        this.position = `X:${data.player_pos.x.toFixed(1)} Y:${data.player_pos.y.toFixed(1)} Z:${data.player_pos.z.toFixed(1)}`\r\n        this.threat = data.threat || '없음'\r\n        this.isConnected = data.is_info_received\r\n        this.signalStrength = this.isConnected ? 4 : 0\r\n      } catch (e) {\r\n        console.error('get_status API 오류:', e)\r\n        this.isConnected = false\r\n        this.signalStrength = 0\r\n      }\r\n    },\r\n    getSignalClass(index) {\r\n      if (!this.isConnected) return 'disconnected'\r\n      if (index <= this.signalStrength) return 'active'\r\n      return 'inactive'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.hud {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\r\n  gap: 1rem;\r\n  padding: 1rem;\r\n  background-color: rgba(0, 255, 0, 0.05);\r\n  border-top: 2px solid #00ff00;\r\n  border-bottom: 2px solid #00ff00;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.hud-item {\r\n  padding: 1rem;\r\n  border: 1px solid #00ff00;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n  background-color: rgba(0, 255, 0, 0.07);\r\n  font-size: 1rem;\r\n}\r\n\r\n.health-bar {\r\n  width: 100%;\r\n  height: 20px;\r\n  background-color: rgba(0, 0, 0, 0.3);\r\n  border: 1px solid #00ff00;\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n  margin: 5px 0;\r\n}\r\n\r\n.health-fill {\r\n  height: 100%;\r\n  background-color: #00ff00;\r\n  transition: width 0.3s ease;\r\n}\r\n\r\n.signal-bar {\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 2px;\r\n  margin-top: 5px;\r\n}\r\n\r\n.bar {\r\n  width: 4px;\r\n  height: 20px;\r\n  background-color: #00ff00;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.bar.active {\r\n  background-color: #00ff00;\r\n  box-shadow: 0 0 5px #00ff00;\r\n}\r\n\r\n.bar.inactive {\r\n  background-color: rgba(0, 255, 0, 0.3);\r\n}\r\n\r\n.bar.disconnected {\r\n  background-color: #ff3c3c;\r\n}\r\n\r\n#signal-error-icon {\r\n  position: absolute;\r\n  right: 5px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  color: #ff3c3c;\r\n  font-weight: bold;\r\n}\r\n\r\n.hud-item.threat-level-1 {\r\n  border-color: #ffa500;\r\n  color: #ffa500;\r\n}\r\n\r\n.hud-item.threat-level-2 {\r\n  border-color: #ff3c3c;\r\n  color: #ff3c3c;\r\n}\r\n\r\n.hud-item.threat-level-3 {\r\n  border-color: #ff3c3c;\r\n  color: #ff3c3c;\r\n  animation: pulse 1s infinite;\r\n}\r\n\r\n.hud-item.threat-none {\r\n  border-color: #00ff00;\r\n  color: #00ff00;\r\n}\r\n\r\n@keyframes pulse {\r\n  0% { box-shadow: 0 0 5px #ff3c3c; }\r\n  50% { box-shadow: 0 0 20px #ff3c3c; }\r\n  100% { box-shadow: 0 0 5px #ff3c3c; }\r\n}\r\n</style> "],"mappings":"AA6BA,eAAe;EACbA,IAAI,EAAE,KAAK;EACXC,IAAIA,CAAA,EAAG;IACL,OAAO;MACLC,KAAK,EAAE,CAAC;MACRC,QAAQ,EAAE,mBAAmB;MAC7BC,MAAM,EAAE,GAAG;MACXC,MAAM,EAAE,IAAI;MACZC,WAAW,EAAE,IAAI;MACjBC,cAAc,EAAE,CAAC;MACjBC,IAAI,EAAE;IACR;EACF,CAAC;EACDC,QAAQ,EAAE;IACRC,WAAWA,CAAA,EAAG;MACZ,IAAI,IAAI,CAACL,MAAK,KAAM,IAAI,EAAE,OAAO,aAAY;MAC7C,IAAI,IAAI,CAACA,MAAM,CAACM,QAAQ,CAAC,IAAI,CAAC,EAAE,OAAO,gBAAe;MACtD,IAAI,IAAI,CAACN,MAAM,CAACM,QAAQ,CAAC,IAAI,CAAC,EAAE,OAAO,gBAAe;MACtD,OAAO,gBAAe;IACxB,CAAC;IACDC,SAASA,CAAA,EAAG;MACV,IAAI,CAAC,IAAI,CAACN,WAAW,EAAE,OAAO,eAAc;MAC5C,IAAI,IAAI,CAACC,cAAa,IAAK,CAAC,EAAE,OAAO,aAAY;MACjD,OAAO,eAAc;IACvB;EACF,CAAC;EACDM,OAAOA,CAAA,EAAG;IACR,IAAI,CAACC,YAAY,CAAC;IAClBC,WAAW,CAAC,IAAI,CAACD,YAAY,EAAE,IAAI;EACrC,CAAC;EACDE,OAAO,EAAE;IACP,MAAMF,YAAYA,CAAA,EAAG;MACnB,IAAI;QACF,MAAMG,GAAE,GAAI,MAAMC,KAAK,CAAC,GAAGC,OAAO,CAACC,GAAG,CAACC,eAAe,aAAa;QACnE,MAAMpB,IAAG,GAAI,MAAMgB,GAAG,CAACK,IAAI,CAAC;QAE5