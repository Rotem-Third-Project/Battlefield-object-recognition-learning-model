 class=\"hud-item\" :class=\"commClass\" id=\"comm\">\r\n      <div>📡 통신 신호</div>\r\n      <div class=\"signal-bar\">\r\n        <div v-for=\"i in 4\" :key=\"i\" \r\n             :class=\"['bar', getSignalClass(i)]\"></div>\r\n        <div v-if=\"!isConnected\" id=\"signal-error-icon\">✖</div>\r\n      </div>\r\n    </div>\r\n    <div class=\"hud-item\" id=\"gear\">\r\n      🔧 기어: <span id=\"gear-level\">{{ gear }}</span>\r\n    </div>\r\n  </div>\r\n</template>\r\n\r\n<script>\r\nexport default {\r\n  name: 'HUD',\r\n  data() {\r\n    return {\r\n      speed: 0,\r\n      position: 'X:0.0 Y:0.0 Z:0.0',\r\n      health: 100,\r\n      threat: '없음',\r\n      isConnected: true,\r\n      signalStrength: 4,\r\n      gear: 2\r\n    }\r\n  },\r\n  computed: {\r\n    threatClass() {\r\n      if (this.threat === '없음') return 'threat-none'\r\n      if (this.threat.includes('높음')) return 'threat-level-3'\r\n      if (this.threat.includes('중간')) return 'threat-level-2'\r\n      return 'threat-level-1'\r\n    },\r\n    commClass() {\r\n      if (!this.isConnected) return 'status-danger'\r\n      if (this.signalStrength <= 1) return 'status-weak'\r\n      return 'status-normal'\r\n    }\r\n  },\r\n  mounted() {\r\n    this.updateStatus()\r\n    setInterval(this.updateStatus, 1000)\r\n  },\r\n  methods: {\r\n    async updateStatus() {\r\n      try {\r\n        const res = await fetch(`${process.env.VUE_APP_API_URL}/get_status`)\r\n        const data = await res.json()\r\n\r\n        this.speed = data.player_speed\r\n        this.health = data.player_health\r\n        this.gear = data.gear || 2\r\n        this.position = `X:${data.player_pos.x.toFixed(1)} Y:${data.player_pos.y.toFixed(1)} Z:${data.player_pos.z.toFixed(1)}`\r\n        this.threat = data.threat || '없음'\r\n        this.isConnected = data.is_info_received\r\n        this.signalStrength = this.isConnected ? 4 : 0\r\n      } catch (e) {\r\n        console.error('get_status API 오류:', e)\r\n        this.isConnected = false\r\n        this.signalStrength = 0\r\n      }\r\n    },\r\n    getSignalClass(index) {\r\n      if (!this.isConnected) return 'disconnected'\r\n      if (index <= this.signalStrength) return 'active'\r\n      return 'inactive'\r\n    }\r\n  }\r\n}\r\n</script>\r\n\r\n<style scoped>\r\n.hud {\r\n  display: grid;\r\n  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));\r\n  gap: 1rem;\r\n  padding: 1rem;\r\n  background-color: rgba(0, 255, 0, 0.05);\r\n  border-top: 2px solid #00ff00;\r\n  border-bottom: 2px solid #00ff00;\r\n  margin-bottom: 1rem;\r\n}\r\n\r\n.hud-item {\r\n  padding: 1rem;\r\n  border: 1px solid #00ff00;\r\n  border-radius: 10px;\r\n  text-align: center;\r\n  background-color: rgba(0, 255, 0, 0.07);\r\n  font-size: 1rem;\r\n}\r\n\r\n.health-bar {\r\n  width: 100%;\r\n  height: 20px;\r\n  background-color: rgba(0, 0, 0, 0.3);\r\n  border: 1px solid #00ff00;\r\n  border-radius: 10px;\r\n  overflow: hidden;\r\n  margin: 5px 0;\r\n}\r\n\r\n.health-fill {\r\n  height: 100%;\r\n  background-color: #00ff00;\r\n  transition: width 0.3s ease;\r\n}\r\n\r\n.signal-bar {\r\n  display: flex;\r\n  justify-content: center;\r\n  gap: 2px;\r\n  margin-top: 5px;\r\n}\r\n\r\n.bar {\r\n  width: 4px;\r\n  height: 20px;\r\n  background-color: #00ff00;\r\n  transition: all 0.3s ease;\r\n}\r\n\r\n.bar.active {\r\n  background-color: #00ff00;\r\n  box-shadow: 0 0 5px #00ff00;\r\n}\r\n\r\n.bar.inactive {\r\n  background-color: rgba(0, 255, 0, 0.3);\r\n}\r\n\r\n.bar.disconnected {\r\n  background-color: #ff3c3c;\r\n}\r\n\r\n#signal-error-icon {\r\n  position: absolute;\r\n  right: 5px;\r\n  top: 50%;\r\n  transform: translateY(-50%);\r\n  color: #ff3c3c;\r\n  font-weight: bold;\r\n}\r\n\r\n.hud-item.threat-level-1 {\r\n  border-color: #ffa500;\r\n  color: #ffa500;\r\n}\r\n\r\n.hud-item.threat-level-2 {\r\n  border-color: #ff3c3c;\r\n  color: #ff3c3c;\r\n}\r\n\r\n.hud-item.threat-level-3 {\r\n  border-color: #ff3c3c;\r\n  color: #ff3c3c;\r\n  animation: pulse 1s infinite;\r\n}\r\n\r\n.hud-item.threat-none {\r\n  border-color: #00ff00;\r\n  color: #00ff00;\r\n}\r\n\r\n@keyframes pulse {\r\n  0% { box-shadow: 0 0 5px #ff3c3c; }\r\n  50% { box-shadow: 0 0 20px #ff3c3c; }\r\n  100% { box-shadow: 0 0 5px #ff3c3c; }\r\n}\r\n</style> "],"mappings":";;EACOA,KAAK,EAAC;AAAK;;EACTA,KAAK,EAAC,UAAU;EAACC,EAAE,EAAC;;;EACpBD,KAAK,EAAC,UAAU;EAACC,EAAE,EAAC;;;EACpBD,KAAK,EAAC,UAAU;EAACC,EAAE,EAAC;;;EAElBD,KAAK,EAAC;AAAY;;EAGlBC,EAAE,EAAC;AAAa;;EAOhBD,KAAK,EAAC;AAAY;;EAhB7BE,GAAA;EAmBiCD,EAAE,EAAC;;;EAG3BD,KAAK,EAAC,UAAU;EAACC,EAAE,EAAC;;;EACVA,EAAE,EAAC;AAAY;;uBAtBhCE,mBAAA,CAwBM,OAxBNC,UAwBM,GAvBJC,mBAAA,CAA2D,OAA3DC,UAA2D,EAA1B,MAAI,GAAAC,gBAAA,CAAGC,KAAA,CAAAC,KAAK,IAAG,OAAK,iBACrDJ,mBAAA,CAA4D,OAA5DK,UAA4D,EAAxB,MAAI,GAAAH,gBAAA,CAAGC,KAAA,CAAAG,QAAQ,kBACnDN,mBAAA,CAMM,OANNO,UAMM,G,0BALJP,mBAAA,CAAgB,aAAX,OAAK,sBACVA,mBAAA,CAEM,OAFNQ,UAEM,GADJR,mBAAA,CAAgE;IAA1DS,KAAK,EAPnBC,eAAA;MAAAC,KAAA,EAO8BR,KAAA,CAAAS,MAAM;IAAA;IAAUjB,KAAK,EAAC;6BAE9CK,mBAAA,CAAyC,OAAzCa,UAAyC,EAAAX,gBAAA,CAAhBC,KAAA,CAAAS,MAAM,IAAG,GAAC,gB,GAErCZ,mBAAA,CAEM;IAFDL,KAAK,EAXdmB,eAAA,EAWe,UAAU,EAASC,QAAA,CAAAC,WAAW;IAAEpB,EAAE,EAAC;KAAS,aAC3C,GAAAM,gBAAA,CAAGC,KAAA,CAAAc,MAAM,yBAErBjB,mBAAA,CAOM;IAPDL,KAAK,EAddmB,eAAA,EAce,UAAU,EAASC,QAAA,CAAAG,SAAS;IAAEtB,EAAE,EAAC;gCAC1CI,mBAAA,CAAmB,aAAd,UAAQ,sBACbA,mBAAA,CAIM,OAJNmB,UAIM,I,cAHJrB,mBAAA,CAC+CsB,SAAA,QAlBvDC,WAAA,CAiByB,CAAC,EAANC,CAAC;WAAbtB,mBAAA,CAC+C;MAD1BH,GAAG,EAAEyB,CAAC;MACrB3B,KAAK,EAlBnBmB,eAAA,SAkB6BC,QAAA,CAAAQ,cAAc,CAACD,CAAC;;mCACzBnB,KAAA,CAAAqB,WAAW,I,cAAvB1B,mBAAA,CAAuD,OAAvD2B,UAAuD,EAAP,GAAC,KAnBzDC,mBAAA,e,oBAsBI1B,mBAAA,CAEM,OAFN2B,UAEM,G,0BAxBVC,gBAAA,CAsBoC,UACvB,IAAA5B,mBAAA,CAAuC,QAAvC6B,WAAuC,EAAA3B,gBAAA,CAAdC,KAAA,CAAA2B,IAAI,iB","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}